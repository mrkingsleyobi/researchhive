# ===========================================
# ResearchHive Environment Configuration
# ===========================================

# ===========================================
# Application
# ===========================================
NODE_ENV=development

# ===========================================
# Web App (Next.js)
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_MCP_URL=http://localhost:4000/api/mcp

# ===========================================
# API Server
# ===========================================
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql://researchhive:researchhive123@localhost:5432/researchhive

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://:researchhive123@localhost:6379

# ===========================================
# RabbitMQ
# ===========================================
RABBITMQ_URL=amqp://researchhive:researchhive123@localhost:5672

# ===========================================
# Qdrant Vector Database
# ===========================================
QDRANT_URL=http://localhost:6333

# ===========================================
# Neo4j Knowledge Graph
# ===========================================
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchhive123

# ===========================================
# Meilisearch
# ===========================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=masterKey

# ===========================================
# Authentication (Logto)
# ===========================================
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_APP_ID=researchhive-app
LOGTO_APP_SECRET=your-app-secret-here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-change-in-production

# ===========================================
# AI Services
# ===========================================
# Anthropic API (Claude AI - Required for real AI research)
ANTHROPIC_API_KEY=sk-ant-your-actual-key-here

# HuggingFace API (for NLP models)
HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# OpenRouter API (for multi-LLM routing)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Claude Flow
AGENTDB_ENABLED=true
CLAUDE_FLOW_ENABLED=true

# ===========================================
# External APIs (Optional)
# ===========================================
# NewsAPI for news aggregation
NEWS_API_KEY=

# Twitter API v2 for social media research
TWITTER_BEARER_TOKEN=

# Reddit API for social media research
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Google Custom Search API (optional, for web scraping)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ===========================================
# Monitoring & Analytics
# ===========================================
SENTRY_DSN=
SENTRY_RELEASE=researchhive@1.0.0

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Resend Email (for notifications)
RESEND_API_KEY=

# ===========================================
# Development
# ===========================================
LOG_LEVEL=info
